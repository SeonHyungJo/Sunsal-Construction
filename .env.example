# alchemy deploy · 데이터 스크립트용 (로컬 Worker 개발은 .dev.vars)
ALCHEMY_PASSWORD=          # alchemy.secret 암호화 키 — 잃어버리면 기존 secret을 복호화할 수 없으니 따로 보관
CLOUDFLARE_API_TOKEN=      # 또는 `npx alchemy login`
CLOUDFLARE_ACCOUNT_ID=
DATA_GO_KR_KEY=            # 공공데이터포털 인증키 (Decoding) — pnpm data:sync
# 아래는 Worker secret으로 올라간다 (.dev.vars.example 참고)
ADMIN_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
