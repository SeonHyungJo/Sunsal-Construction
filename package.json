{
  "name": "sunsal-construction",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/api/tsconfig.json && tsc -p apps/web/tsconfig.json",
    "lint": "oxlint --type-aware",
    "format": "oxfmt --write",
    "test": "pnpm -r test",
    "build": "pnpm --filter 'web...' build",
    "deploy": "pnpm build && alchemy deploy --stage prod",
    "data:sync": "node packages/data/scripts/sync-kapt.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "alchemy": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0"
}
