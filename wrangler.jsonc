// 로컬 개발용. 운영 배포는 alchemy.run.ts가 선언한다.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sunsal",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/rpc/*", "/api/*"],
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "local",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:54322/postgres",
    },
  ],
  "triggers": { "crons": ["0 18 * * *", "*/10 * * * *", "0 1 * * *", "30 1 * * *"] },
  "ratelimits": [
    { "name": "SEARCH_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    {
      "name": "CORRECTION_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 3, "period": 60 },
    },
  ],
}
